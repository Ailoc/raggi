# 前端源码在 web/src（TypeScript + Svelte），
# web/dist 是 Vite 构建产物，运行前由 npm run build 生成，不入库
node_modules/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
# setuptools 构建产物：rag/ 的陈旧副本，会污染全文搜索
build/
dist/

# 运行时数据目录（LanceDB + 留档原文 + config.toml）。
# **必须带前导斜杠**：不锚定的 `data/` 会匹配任意层级里叫 data 的目录，
# 于是把源码 `web/src/data/apidoc.ts`（手写接口文档，三个测试直接读它）
# 一起排除掉 —— 结果是仓库从干净检出根本构建不起来，而本地因为已有那份文件
# 一切正常，只有 CI 能发现。这个坑真踩过，见 docs/ARCH-AUDIT-2026-10-06.md。
/data/
# Svelte/Vite 构建产物
web/dist/

# 代理/编辑器的本地状态（权限决定、口味文件），不是项目源码
.commandcode/
.venv/
venv/
